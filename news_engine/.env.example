# ====================================================================
# EXTRASAGA Zero-Cost AI News Automation System - Environment Variables
# Copy this file to .env and customize for your environment
# ====================================================================

# --- APPLICATION SETTINGS ---
APP_NAME="EXTRASAGA Autonomous News Engine"
APP_ENV="development" # development | production | test
LOG_LEVEL="INFO"
SECRET_KEY="change-me-to-a-very-long-random-string-in-production"
ADMIN_PASSWORD="admin-secure-password-2026"

# --- LOCAL AI ENGINE (OLLAMA) ---
# Zero-cost local LLM running via Ollama. Download models using: ollama pull llama3.2
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2" # e.g., llama3.2, mistral, qwen2.5:7b, gemma2:9b
OLLAMA_TIMEOUT_SECONDS=120

# --- DATABASE CONFIGURATION ---
# Default: High-performance async SQLite for instant zero-dependency local execution
# Production: postgresql+asyncpg://postgres:postgres@localhost:5432/extrasaga_news
DATABASE_URL="sqlite+aiosqlite:///./extrasaga_news.db"

# --- REDIS / CELERY CACHE & QUEUE ---
REDIS_URL="redis://localhost:6379/0"
USE_CELERY=false # false uses built-in high-performance asyncio scheduler

# --- WEBSITE PUBLISHING INTEGRATION ---
# Points to your existing Next.js / Cloudflare / GitHub hosted website
WEBSITE_API_URL="http://localhost:3001"
ADMIN_SECRET_KEY="cinijaatre-super-secret-admin-key-2026"
DEFAULT_AUTHOR_NAME="EXTRASAGA Bureau"
DEFAULT_AUTHOR_ROLE="Editor"

# Direct Supabase PostgreSQL Publishing (Optional - fallback to HTTP API)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AUTOMATION & SCHEDULING ---
DISCOVERY_INTERVAL_MINUTES=5
DISCOVERY_CANDIDATE_TARGET=500 # Aim for 100-1000 candidate records per cycle
MAX_CONCURRENT_EXTRACTIONS=10
PER_DOMAIN_RATE_LIMIT_DELAY_SECONDS=1.0

# --- FACT VERIFICATION THRESHOLDS ---
VERIFICATION_MIN_SCORE=75 # Out of 100
MIN_INDEPENDENT_CORROBORATING_SOURCES=2
MAX_STORY_AGE_HOURS=48
STRICT_CONTRADICTION_BLOCK=true

# --- SAFETY, DRY-RUN & EMERGENCY CONTROLS ---
DRY_RUN_MODE=true # Start true. When true, processes & generates articles without pushing to live site
EMERGENCY_PUBLISH_PAUSE=false # Set to true to instantly halt all publishing across the fleet
REQUIRE_MANUAL_APPROVAL_FOR_HIGH_RISK=true
HIGH_RISK_CATEGORIES="health,elections,politics,crime,legal"

# --- SEARXNG METASEARCH (OPTIONAL) ---
SEARXNG_BASE_URL="http://localhost:8888"
USE_SEARXNG=false
