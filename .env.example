# ==========================================================
# Cini Jaatre (ಸಿನಿ ಜಾತ್ರೆ) - Environment Configuration
# ==========================================================

# 1. Site Domain & Base URL
# Local: http://localhost:3000
# Staging: https://staging.cinijaatre.com or https://your-preview.vercel.app
# Production: https://cinijaatre.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Cloud Configuration (PostgreSQL Database & Realtime)
# Required for production persistence & multi-user live updates
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Editorial Admin Portal Security
# Set strong, unique credentials in production
ADMIN_EMAIL=admin@cinijaatre.com
ADMIN_PASSWORD=change-this-in-production-to-strong-password
ADMIN_SECRET_KEY=generate-a-secure-random-64-character-string-for-hmac-sessions

# 4. Automated Cron & Ingestion Engine Secrets
CRON_SECRET=generate-a-secure-random-token-for-vercel-cron-headers
INGEST_SECRET=generate-a-secure-random-token-for-cron-triggers

# 5. Payment Gateway (For Future Booking Integration)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 6. Sentry Error Tracking & Observability (Optional)
# SENTRY_DSN=https://xxxxxxxx@o000000.ingest.sentry.io/000000
